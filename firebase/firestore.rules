// Reglas de seguridad recomendadas para Firestore
// Copiar y pegar estas reglas en Firebase Console -> Firestore -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función para verificar si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Función para verificar si los datos del usuario son válidos
    function isValidUserData() {
      return request.resource.data.keys().hasAll(['nombre', 'email', 'tipo']) &&
             request.resource.data.tipo in ['productor', 'comprador', 'transportista'];
    }
    
    // Reglas para la colección de usuarios
    match /usuarios/{userId} {
      // Permitir lectura solo al propio usuario
      allow read: if isOwner(userId);
      
      // Permitir creación solo si el usuario está autenticado y es su propio documento
      allow create: if isOwner(userId) && isValidUserData();
      
      // Permitir actualización solo al propio usuario
      allow update: if isOwner(userId);
      
      // Permitir eliminación solo al propio usuario
      allow delete: if isOwner(userId);
    }
    
    // Reglas para productos (cuando se implemente)
    match /productos/{productId} {
      // Permitir lectura a todos los usuarios autenticados
      allow read: if isAuthenticated();
      
      // Permitir creación solo a productores
      allow create: if isAuthenticated() && 
                      get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'productor';
      
      // Permitir actualización solo al dueño del producto
      allow update: if isAuthenticated() && 
                      resource.data.idVendedor == request.auth.uid;
      
      // Permitir eliminación solo al dueño del producto
      allow delete: if isAuthenticated() && 
                      resource.data.idVendedor == request.auth.uid;
    }
    
    // Reglas temporales para desarrollo (QUITAR EN PRODUCCIÓN)
    // Permitir lectura/escritura si el usuario está autenticado
    // match /{document=**} {
    //   allow read, write: if isAuthenticated();
    // }
  }
}
