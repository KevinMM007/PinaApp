rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para usuarios
    match /usuarios/{userId} {
      // Permitir lectura del propio perfil
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Permitir lectura de perfiles públicos (para marketplace)
      allow read: if request.auth != null && resource.data.perfilPublico == true;
      
      // Permitir escritura solo al propietario
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para productos
    match /productos/{productId} {
      // Permitir lectura a todos los usuarios autenticados
      allow read: if request.auth != null;
      
      // Permitir crear si está autenticado y es productor
      allow create: if request.auth != null 
                   && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'productor';
      
      // Permitir actualizar/eliminar solo al propietario
      allow update, delete: if request.auth != null 
                          && resource.data.productorId == request.auth.uid;
    }
    
    // Reglas para perfiles específicos por tipo
    match /{tipoColeccion}/{perfilId} {
      // Para productores, compradores y transportistas
      allow read: if request.auth != null 
                  && tipoColeccion in ['productores', 'compradores', 'transportistas']
                  && (request.auth.uid == perfilId || resource.data.publico == true);
      
      allow write: if request.auth != null 
                   && tipoColeccion in ['productores', 'compradores', 'transportistas']
                   && request.auth.uid == perfilId;
    }
  }
}
